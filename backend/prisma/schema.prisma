generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  githubId     String?  @unique
  avatarUrl    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  projects     Project[]
  testSuites   TestSuite[]
}

model Project {
  id            String   @id @default(cuid())
  name          String
  description   String?
  ownerId       String
  owner         User     @relation(fields: [ownerId], references: [id])
  githubRepoUrl String?
  githubBranch  String   @default("main")
  apiSpecPath   String?
  status        String   @default("DRAFT")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  testSuites    TestSuite[]
  apiSpecs      ApiSpec[]
}

model ApiSpec {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id])
  specData      String   @default("{}")
  specVersion   String   @default("3.0.0")
  parsedAt      DateTime @default(now())
  endpointsCount Int     @default(0)
  schemasCount  Int      @default(0)
}

model TestSuite {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id])
  name          String
  totalTests    Int      @default(0)
  passedTests   Int      @default(0)
  failedTests   Int      @default(0)
  successRate   Float    @default(0)
  createdAt     DateTime @default(now())
  lastRunAt     DateTime?
  
  testCases     TestCase[]
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
}

model TestCase {
  id              String   @id @default(cuid())
  suiteId         String
  suite           TestSuite @relation(fields: [suiteId], references: [id])
  category        String   @default("POSITIVE")
  method          String
  endpoint        String
  requestHeaders  String   @default("{}")
  requestBody     String?  @default("{}")
  expectedStatus  Int
  expectedResponse String? @default("{}")
  description     String?
  isGenerated     Boolean  @default(true)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  
  testResults     TestResult[]
}

model TestResult {
  id              String   @id @default(cuid())
  testCaseId      String
  testCase        TestCase @relation(fields: [testCaseId], references: [id])
  runId           String
  status          String   @default("PASSED")
  responseStatus  Int?
  responseBody    String?
  responseTime    Float?
  errorMessage    String?
  executedAt      DateTime @default(now())
}